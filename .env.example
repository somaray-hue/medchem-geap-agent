# =============================================================================
# MedChem GEAP Enterprise Agent — Environment Template
# Copy to `.env` for local development ONLY. Never commit real secrets.
# In production on Google Cloud / GEAP, secrets are fetched dynamically from
# Google Cloud Secret Manager via `medchem_agent.config.secrets.SecretProvider`.
# =============================================================================

# Deployment environment: local | staging | production
APP_ENV=local
LOG_LEVEL=INFO

# Google Cloud / Vertex AI / GEAP Configuration
# Set GOOGLE_GENAI_USE_VERTEXAI=TRUE when deploying to GEAP / Vertex AI
GOOGLE_GENAI_USE_VERTEXAI=FALSE
GCP_PROJECT_ID=
GCP_LOCATION=us-central1
AGENT_ENGINE_ID=

# Local Gemini API key (ONLY for local dev when GOOGLE_GENAI_USE_VERTEXAI=FALSE)
# In production, stored in Secret Manager as `gemini-api-key`
GOOGLE_API_KEY=

# Strategic Model Routing Overrides
# For unbilled AI Studio free-tier local prototyping, set both to `gemini-3.5-flash-lite`.
MODEL_FAST=gemini-3.5-flash
MODEL_REASONING=gemini-3.1-pro-preview
TXGEMMA_ENDPOINT_ID=

# Persistent Session & Memory Stores
# Locally defaults to persistent SQLite; in production use Cloud SQL PostgreSQL or VertexAiSessionService
SESSION_DB_URL=sqlite+aiosqlite:///./data/medchem_sessions.db
MEMORY_DB_PATH=./data/medchem_memory.db
ELN_DB_PATH=./data/enterprise_eln.db

# Governance & Security Controls
ENABLE_CLOUD_DLP=false
ENABLE_MODEL_ARMOR=false
MODEL_ARMOR_TEMPLATE_ID=
ENABLE_SECRET_MANAGER=false

# Observability (OpenTelemetry)
OTEL_SERVICE_NAME=medchem-geap-agent
OTEL_EXPORTER_OTLP_ENDPOINT=
ENABLE_CLOUD_TRACE=false

# Optional external science API keys (fetched via Secret Manager in prod)
PUBCHEM_API_KEY=
ELN_API_TOKEN=
